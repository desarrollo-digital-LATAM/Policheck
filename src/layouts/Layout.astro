---
const {
	title = 'ALBERLIC | Pruebas de Polígrafo y Evaluación de Confianza',
	description = 'Conoce los servicios de ALBERLIC para pruebas de polígrafo y evaluación poligráfica en Perú. Atención profesional, confidencial y personalizada.',
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = Astro.site ? new URL('/images/og-alberlic.png', Astro.site).href : undefined;
const organization = {
	'@type': 'Organization',
	name: 'ALBERLIC',
	telephone: '+51966994027',
	...(Astro.site ? { url: Astro.site.href } : {}),
};
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [organization, ...(Astro.site ? [{ '@type': 'WebSite', name: 'ALBERLIC', url: Astro.site.href }] : [])],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f4f1e9" />
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_PE" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{socialImage && <meta property="og:image" content={socialImage} />}
		{socialImage && <meta property="og:image:type" content="image/png" />}
		{socialImage && <meta property="og:image:width" content="1200" />}
		{socialImage && <meta property="og:image:height" content="630" />}
		{socialImage && <meta property="og:image:alt" content="ALBERLIC: Pruebas de Polígrafo y Evaluación de Confianza" />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImage && <meta name="twitter:image" content={socialImage} />}
		{socialImage && <meta name="twitter:image:alt" content="ALBERLIC: Pruebas de Polígrafo y Evaluación de Confianza" />}
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
		<title>{title}</title>
	</head>
	<body><slot /></body>
</html>

<style>
	:global(html), :global(body) { margin: 0; min-width: 320px; }
	:global(body) { font-family: 'DM Sans', Arial, sans-serif; }
</style>
