---
import Layout from "../../layouts/Layout.astro";

const whatsapp = (message: string) => `https://wa.me/51966994027?text=${encodeURIComponent(message)}`;
const services = [
  ["01", "Publicidad y creatividad", "Conceptos y piezas de comunicación pensados para expresar con claridad la propuesta de cada marca.", "✳"],
  ["02", "Branding e identidad visual", "Desarrollo de recursos visuales y lineamientos que ayudan a construir una identidad reconocible.", "◈"],
  ["03", "Impresiones y producción gráfica", "Piezas impresas y materiales gráficos definidos de acuerdo con las necesidades de cada proyecto.", "▤"],
  ["04", "Merchandising corporativo", "Artículos promocionales y recursos de marca para acompañar iniciativas comerciales e institucionales.", "◇"],
  ["05", "Eventos y activaciones", "Ideas y materiales de comunicación para encuentros, acciones promocionales y experiencias de marca.", "◎"],
  ["06", "Estrategias de comunicación", "Planificación de mensajes y formatos para conectar una organización con sus públicos.", "↗"],
  ["07", "Producción audiovisual", "Contenido audiovisual para presentar marcas, productos e iniciativas en distintos canales.", "▷"],
  ["08", "Soluciones integrales de comunicación", "Una propuesta coordinada que puede reunir varias de estas categorías según el objetivo del proyecto.", "⌘"],
];
---

<Layout title="Comunicación y Producción Publicitaria | ALBERLIC" description="Soluciones de comunicación, creatividad, branding y producción publicitaria para necesidades corporativas y comerciales." ogImageAlt="ALBERLIC: soluciones integrales de comunicación y producción publicitaria">
  <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
  <div class="ad-shell">
    <header class="ad-header"><a class="brand" href="/" aria-label="ALBERLIC, inicio"><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>ALBERLIC</span></a><nav aria-label="Navegación principal"><a href="/#nosotros">Nosotros</a><a href="/#lineas">Líneas de negocio</a><a href="#servicios">Servicios</a><a href="#contacto">Contacto</a></nav><a class="header-cta" href={whatsapp("Hola, quisiera solicitar información sobre los servicios de comunicación y producción publicitaria de ALBERLIC.")} target="_blank" rel="noreferrer">Conversemos <span aria-hidden="true">↗</span></a><details class="mobile-menu"><summary aria-label="Abrir menú"><span></span><span></span><span></span></summary><nav aria-label="Navegación móvil"><a href="/#nosotros">Nosotros</a><a href="/#lineas">Líneas de negocio</a><a href="#servicios">Servicios</a><a href="#contacto">Contacto</a></nav></details></header>
    <main id="contenido">
      <section class="ad-hero"><div class="ad-hero-copy"><a class="back-link" href="/#lineas">← Volver a líneas de negocio</a><p class="eyebrow"><span class="eyebrow-dot"></span> Línea 01 / Comunicación</p><h1>Soluciones integrales de comunicación y producción publicitaria</h1><p>Ideas y recursos para comunicar marcas, productos y organizaciones con intención.</p><a class="button button-primary" href="#servicios">Explorar servicios <span aria-hidden="true">↓</span></a></div><div class="creative-board" aria-label="Composición gráfica abstracta de comunicación visual"><div class="board-top"><span>ALBERLIC / ESTUDIO DE IDEAS</span><span>01—08</span></div><div class="board-letter">Aa</div><div class="board-bottom"><span>IDEA<br/>→ FORMA</span><i></i><b>Comunicación<br/>que toma forma.</b></div><span class="board-stamp">CONCEPTO<br/>EN MOVIMIENTO</span></div></section>
      <section class="intro-section"><p class="section-kicker">Comunicar con intención</p><div><h2>De una idea a una <em>experiencia de marca.</em></h2><p>Esta unidad desarrolla propuestas de comunicación y producción publicitaria para necesidades corporativas y comerciales. El punto de partida es comprender el objetivo y definir los recursos que mejor pueden expresarlo.</p></div></section>
      <section class="services-section" id="servicios" aria-labelledby="services-title"><div class="services-heading"><div><p class="section-kicker">Unidades de servicio / 01—08</p><h2 id="services-title">Recursos para dar forma<br/><em>a cada mensaje.</em></h2></div><p>Las categorías pueden abordarse de manera individual o articularse en una propuesta según el alcance de cada consulta.</p></div><div class="service-list">{services.map(([number, title, description, icon], index) => <article class:list={["service-item", { "service-featured": index === 0 || index === 7 }]}><span class="service-number">{number}</span><span class="service-icon" aria-hidden="true">{icon}</span><div class="service-copy"><h3>{title}</h3><p>{description}</p></div><span class="service-arrow" aria-hidden="true">↗</span></article>)}</div></section>
      <section class="applications"><div><p class="section-kicker">Pensado para diferentes formatos</p><h2>Una marca puede hablar en <em>muchos espacios.</em></h2><p>Desde una identidad visual hasta materiales para una campaña, un evento o canales audiovisuales: conversamos contigo para identificar el formato y el alcance que mejor responden a tu necesidad.</p><a class="text-link" href={whatsapp("Hola, quisiera conversar sobre una solución de comunicación y producción publicitaria para mi empresa.")} target="_blank" rel="noreferrer">Conversemos sobre tu proyecto <span aria-hidden="true">↗</span></a></div><div class="format-stack" aria-hidden="true"><div><span>01</span><b>IDENTIDAD</b><i>Abc</i></div><div><span>02</span><b>CAMPAÑA</b><i>↗</i></div><div><span>03</span><b>CONTENIDO</b><i>▶</i></div></div></section>
      <section class="ad-cta" id="contacto"><p class="section-kicker">El siguiente paso empieza con una conversación</p><h2>¿Qué quieres comunicar?</h2><p>Cuéntanos brevemente sobre tu empresa o proyecto. Te contactaremos por WhatsApp para conocer tu consulta.</p><a class="button button-primary" href={whatsapp("Hola, quisiera solicitar información sobre los servicios de comunicación y producción publicitaria de ALBERLIC.")} target="_blank" rel="noreferrer">Solicitar información por WhatsApp <span aria-hidden="true">↗</span></a><span class="contact-number">+51 966 994 027</span></section>
    </main>
    <footer class="ad-footer"><a class="brand" href="/" aria-label="ALBERLIC, inicio"><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>ALBERLIC</span></a><div><a href="/">Inicio</a><a href="/poligrafo/">Evaluación poligráfica</a><a href="/#lineas">Líneas de negocio</a></div><span>© 2026 ALBERLIC. Todos los derechos reservados.</span></footer>
  </div>
</Layout>

<style>
  :global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#f4f1e9;color:#172422;font-family:"DM Sans",Arial,sans-serif}:global(a){color:inherit}.ad-shell{overflow:clip}.ad-header,main,.ad-footer{width:min(1180px,calc(100% - 64px));margin:auto}.ad-header{height:96px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #1724222e}.brand{display:inline-flex;align-items:center;gap:10px;font-size:20px;font-weight:700;letter-spacing:-.05em;text-decoration:none}.brand-mark{width:26px;height:26px;display:inline-flex;align-items:end;justify-content:center;gap:3px;padding:5px;border-radius:7px;background:#d7f35a;transform:rotate(-8deg)}.brand-mark span{width:3px;background:#172422;border-radius:3px;transform:rotate(8deg)}.brand-mark span:nth-child(1){height:7px}.brand-mark span:nth-child(2){height:12px}.brand-mark span:nth-child(3){height:16px}.ad-header nav{display:flex;gap:22px;margin-left:auto;margin-right:25px}.ad-header nav a,.ad-footer a{font-size:14px;text-decoration:none;color:#495650}.header-cta,.button{display:inline-flex;align-items:center;justify-content:center;gap:13px;border-radius:100px;font-weight:700;text-decoration:none;transition:transform .2s ease,background .2s ease}.header-cta{padding:14px 19px;color:#f6f3ea;background:#172422}.header-cta:hover,.button:hover{transform:translateY(-2px)}.mobile-menu{display:none}.ad-hero{display:grid;grid-template-columns:1fr .95fr;align-items:center;gap:65px;padding:68px 0 96px}.back-link{display:inline-block;margin-bottom:34px;color:#526159;font-size:14px;text-decoration:none}.back-link:hover,.text-link:hover{color:#718b0c}.eyebrow,.section-kicker{color:#596b13;font-size:12px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.eyebrow{display:flex;align-items:center;gap:10px}.eyebrow-dot{width:8px;height:8px;border-radius:50%;background:#91ae16;box-shadow:0 0 0 4px #e0e9b7}h1,h2,h3,p{margin:0}.ad-hero h1,.intro-section h2,.services-heading h2,.applications h2,.ad-cta h2{font:500 clamp(45px,5vw,68px)/.99 "DM Serif Display",Georgia,serif;letter-spacing:-.05em}.ad-hero h1{margin:23px 0;max-width:650px;text-transform:uppercase;font-size:clamp(42px,4.6vw,63px)}.ad-hero-copy>p:not(.eyebrow){max-width:500px;color:#4e5d54;font-size:18px;line-height:1.65;margin-bottom:28px}.button{padding:17px 22px}.button-primary{color:#172422;background:#d7f35a}.creative-board{position:relative;min-height:445px;padding:24px;border-radius:9px;color:#eff1e4;background:#1b2926;overflow:hidden;box-shadow:18px 24px 55px #1724221a}.board-top,.board-bottom{display:flex;justify-content:space-between;align-items:center}.board-top{font-size:10px;letter-spacing:.15em;color:#c1ccaf}.board-letter{position:absolute;left:34px;top:73px;font:italic 300 248px/.95 "DM Serif Display",Georgia,serif;color:#d7f35a;letter-spacing:-.12em}.board-bottom{position:absolute;bottom:26px;left:25px;right:25px;z-index:1;font-size:11px;line-height:1.45;letter-spacing:.1em}.board-bottom i{height:42px;border-left:1px solid #68786b}.board-bottom b{font:500 24px/1.05 "DM Serif Display",Georgia,serif;letter-spacing:-.02em}.board-stamp{position:absolute;right:21px;top:100px;padding:12px;border:1px solid #728061;border-radius:50%;color:#d7f35a;font-size:9px;text-align:center;transform:rotate(12deg)}.intro-section{display:grid;grid-template-columns:.6fr 1.4fr;gap:75px;padding:94px 8%;background:#e9e6dd;margin:0 calc((100vw - min(1180px,calc(100vw - 64px)))/-2)}.intro-section h2,.services-heading h2,.applications h2{font-size:clamp(40px,4.4vw,59px)}.intro-section>div>p{max-width:710px;margin-top:20px;color:#4e5b53;font-size:17px;line-height:1.7}.services-section{padding:115px 0 125px}.services-heading{display:flex;align-items:end;justify-content:space-between;gap:50px;margin-bottom:48px}.services-heading h2{margin-top:17px}.services-heading>p{max-width:360px;color:#536158;font-size:16px;line-height:1.65}.service-list{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #17242224}.service-item{position:relative;min-height:212px;display:grid;grid-template-columns:42px 54px 1fr 24px;align-items:start;gap:18px;padding:28px 23px;border-bottom:1px solid #17242224;transition:background .2s ease}.service-item:hover{background:#e9e6dd}.service-featured{background:#eeece4}.service-number{padding-top:6px;color:#7b9018;font-size:12px;font-weight:700}.service-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:#e0e9bd;color:#617809;font-size:22px}.service-copy h3{margin:3px 0 10px;font:500 24px/1.08 "DM Serif Display",Georgia,serif;letter-spacing:-.02em}.service-copy p{max-width:390px;color:#536158;font-size:14px;line-height:1.55}.service-arrow{padding-top:7px;color:#718b0c;font-size:20px}.applications{display:grid;grid-template-columns:1fr .75fr;gap:80px;align-items:center;padding:84px 7%;margin:0 calc((100vw - min(1180px,calc(100vw - 64px)))/-2);background:#d7f35a}.applications h2{margin:18px 0}.applications>div:first-child>p:not(.section-kicker){max-width:540px;color:#3c4a36;font-size:16px;line-height:1.7}.text-link{display:inline-flex;gap:10px;margin-top:23px;padding-bottom:7px;border-bottom:1px solid #526333;font-weight:700;font-size:14px;text-decoration:none}.format-stack{position:relative;min-height:260px}.format-stack div{position:absolute;width:260px;height:95px;padding:14px 17px;display:grid;grid-template-columns:1fr auto;align-items:center;border:1px solid #72852d;border-radius:5px;background:#e3f28c;box-shadow:8px 10px 0 #b5ce48}.format-stack div:nth-child(1){top:0;left:12%;transform:rotate(-7deg)}.format-stack div:nth-child(2){top:75px;left:25%;transform:rotate(5deg);background:#1b2926;color:#eef1e5;border-color:#34453d;box-shadow:8px 10px 0 #748528}.format-stack div:nth-child(3){top:150px;left:4%;transform:rotate(-3deg);background:#f7f5ed}.format-stack span,.format-stack b{font-size:10px;letter-spacing:.1em}.format-stack i{grid-column:2;grid-row:1/3;font:italic 37px "DM Serif Display",Georgia,serif}.ad-cta{padding:100px 20px;text-align:center}.ad-cta h2{margin:20px 0}.ad-cta>p:not(.section-kicker){max-width:500px;margin:0 auto 28px;color:#536158;font-size:16px;line-height:1.65}.contact-number{display:block;margin-top:18px;color:#657168;font-size:13px}.ad-footer{display:grid;grid-template-columns:1fr 1fr auto;align-items:center;gap:24px;padding:28px 0 35px;border-top:1px solid #17242224}.ad-footer>div{display:flex;gap:18px}.ad-footer>span{color:#617067;font-size:12px}.skip-link{position:fixed;z-index:20;top:-100px;left:20px;padding:13px 18px;border-radius:8px;background:#d7f35a;font-weight:700}.skip-link:focus{top:16px}@media(max-width:950px){.ad-header nav{gap:12px}.service-item{grid-template-columns:30px 45px 1fr 18px;gap:12px;padding:24px 14px}}@media(max-width:800px){.ad-header,main,.ad-footer{width:min(100% - 38px,600px)}.ad-header{height:79px}.ad-header>nav,.header-cta{display:none}.mobile-menu{display:block}.mobile-menu summary{display:grid;gap:4px;padding:11px;cursor:pointer;list-style:none}.mobile-menu summary span{width:23px;border-top:2px solid #172422}.mobile-menu nav{position:absolute;z-index:5;top:66px;right:19px;display:grid;width:225px;padding:12px;border:1px solid #ccd3c9;border-radius:9px;background:#f9f7f1;box-shadow:0 14px 28px #1724221f}.mobile-menu nav a{padding:12px;font-weight:700;text-decoration:none}.ad-hero{grid-template-columns:1fr;gap:40px;padding:48px 0 70px}.creative-board{min-height:375px}.board-letter{font-size:210px}.intro-section{grid-template-columns:1fr;gap:24px;margin:0 -19px;padding:62px 19px}.services-section{padding:78px 0}.services-heading{display:block}.services-heading>p{margin-top:18px}.service-list{grid-template-columns:1fr}.service-item{min-height:170px;grid-template-columns:30px 45px 1fr 18px;gap:12px;padding:22px 4px}.service-copy h3{font-size:22px}.applications{grid-template-columns:1fr;gap:42px;margin:0 -19px;padding:65px 19px}.format-stack{min-height:245px;max-width:410px;width:100%;margin:auto}.format-stack div{width:min(260px,75%)}.ad-cta{padding:75px 0}.ad-footer{grid-template-columns:1fr;gap:20px;padding-bottom:90px}.ad-footer>div{flex-direction:column;gap:12px}}@media(max-width:430px){.ad-hero h1{font-size:39px}.creative-board{min-height:330px}.board-letter{top:66px;font-size:185px}.board-stamp{top:80px}.service-item{grid-template-columns:25px 39px 1fr 14px;gap:9px}.service-icon{width:38px;height:38px}.service-copy h3{font-size:20px}.service-copy p{font-size:13px}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.service-item,.button,.header-cta{transition:none}}
</style>
