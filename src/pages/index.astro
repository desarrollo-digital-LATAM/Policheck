---
import Layout from "../layouts/Layout.astro";

const whatsapp = (message: string) =>
  `https://wa.me/51966994027?text=${encodeURIComponent(message)}`;
---

<Layout
  title="INVERSIONES ALBERLIC | Líneas de negocio"
  description="Comunicación y producción publicitaria, junto con servicios especializados de evaluación de confianza. Conoce las áreas de actividad de INVERSIONES ALBERLIC."
  ogImageAlt="INVERSIONES ALBERLIC — Comunicación y evaluación de confianza"
>
  <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
  <div class="corporate-shell">
    <header class="corp-header">
      <a class="brand" href="/" aria-label="INVERSIONES ALBERLIC, inicio">
        <span class="brand-investments">INVERSIONES</span><span class="brand-name">ALBERLIC</span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="/">Inicio</a><a href="#lineas">Líneas de negocio</a><a href="#contacto">Contacto</a>
      </nav>
      <details class="mobile-menu">
        <summary aria-label="Abrir menú de navegación"><span></span><span></span><span></span></summary>
        <nav aria-label="Navegación móvil">
          <a href="/">Inicio</a><a href="#lineas">Líneas de negocio</a><a href="#contacto">Contacto</a>
        </nav>
      </details>
    </header>

    <main id="contenido">
      <section class="corp-hero" aria-labelledby="page-title">
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="eyebrow"><span></span> INVERSIONES ALBERLIC</p>
            <h1 id="page-title">Dos líneas de negocio<br /><em>Soluciones para cada necesidad</em></h1>
            <p class="hero-description">Comunicación y producción publicitaria, junto con servicios especializados de evaluación de confianza. Conoce nuestras áreas de actividad y encuentra el servicio que necesitas.</p>
            <a class="hero-link" href="#lineas">Descubrir nuestras líneas <span aria-hidden="true">↓</span></a>
          </div>
          <figure class="hero-visual">
            <img src="/images/alberlic-hero.jpg" alt="Muestras de color, herramientas y materiales de diseño gráfico sobre una mesa" fetchpriority="high" width="1500" height="1000" />
            <figcaption><span>Ideas que toman forma</span><span class="caption-line"></span><span>Evaluación con criterio</span></figcaption>
            <span class="visual-index" aria-hidden="true">01 <i>—</i> 02</span>
          </figure>
          <span class="hero-side-note" aria-hidden="true">COMUNICACIÓN&nbsp;&nbsp; / &nbsp;&nbsp;EVALUACIÓN</span>
        </div>
      </section>

      <section class="lines-section" id="lineas" aria-labelledby="lines-title">
        <div class="section-heading">
          <div><p class="eyebrow"><span></span> INVERSIONES ALBERLIC</p><h2 id="lines-title">Nuestras líneas de negocio</h2></div>
          <p>Dos áreas especializadas.<br />Elige por dónde empezar.</p>
        </div>
        <div class="business-lines">
          <a class="business-card business-card-creative" href="/comunicacion-publicitaria/" aria-label="Explorar línea 01: Soluciones integrales de comunicación y producción publicitaria">
            <img class="card-photo" src="/images/alberlic-comunicacion.jpg" alt="Muestras de color y materiales para diseño gráfico" loading="lazy" width="1200" height="936" />
            <span class="card-shade" aria-hidden="true"></span>
            <span class="card-number">01 <i>/</i> 02</span>
            <span class="card-content">
              <span class="card-category">Comunicación &amp; producción</span>
              <span class="business-title">SOLUCIONES INTEGRALES DE COMUNICACIÓN Y PRODUCCIÓN PUBLICITARIA</span>
              <span class="business-description">Comunicación, creatividad, identidad visual y producción publicitaria para marcas y organizaciones.</span>
              <span class="card-link">Explorar servicios <span aria-hidden="true">↗</span></span>
            </span>
            <span class="card-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="business-card business-card-trust" href="/poligrafo/" aria-label="Explorar línea 02: Servicios especializados de evaluación, inteligencia corporativa y gestión de riesgos">
            <img class="card-photo" src="/images/alberlic-evaluacion.jpg" alt="Conversación de evaluación profesional en un entorno de oficina" loading="lazy" width="1200" height="675" />
            <span class="card-shade" aria-hidden="true"></span>
            <span class="card-number">02 <i>/</i> 02</span>
            <span class="card-content">
              <span class="card-category">Evaluación &amp; confianza</span>
              <span class="business-title">SERVICIOS ESPECIALIZADOS DE EVALUACIÓN, INTELIGENCIA CORPORATIVA Y GESTIÓN DE RIESGOS</span>
              <span class="business-description">Servicios confirmados de evaluación poligráfica y de confianza para personas y organizaciones.</span>
              <span class="card-link">Explorar servicios <span aria-hidden="true">↗</span></span>
            </span>
            <span class="card-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="contact-band" id="contacto" aria-label="Contacto">
        <div><p>¿Tienes una consulta?</p><span>Estamos a un mensaje de distancia.</span></div>
        <a class="contact-link" href={whatsapp("Hola, quisiera recibir información sobre las líneas de negocio de INVERSIONES ALBERLIC.")} target="_blank" rel="noreferrer">Conversemos por WhatsApp <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer class="corp-footer">
      <a class="brand footer-brand" href="/" aria-label="INVERSIONES ALBERLIC, inicio"><span class="brand-investments">INVERSIONES</span><span class="brand-name">ALBERLIC</span></a>
      <nav aria-label="Líneas de negocio"><a href="/comunicacion-publicitaria/">Comunicación y producción publicitaria</a><a href="/poligrafo/">Evaluación poligráfica</a></nav>
      <span>© 2026 INVERSIONES ALBERLIC</span>
    </footer>
  </div>
</Layout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #f2f6fa; color: #111f40; font-family: "DM Sans", Arial, sans-serif; }
  :global(a) { color: inherit; }
  .corporate-shell { --radius-card: 16px; --radius-media: 15px; --radius-control: 9px; --radius-menu: 9px; overflow: clip; }
  .corp-header, main, .corp-footer { width: min(1240px, calc(100% - 64px)); margin: auto; }
  .corp-header { position: relative; z-index: 4; height: 78px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #d7e0e9; }
  .brand { display: inline-flex; align-items: baseline; gap: 8px; color: #111f40; text-decoration: none; white-space: nowrap; }
  .brand-investments { font-size: 12px; font-weight: 500; letter-spacing: .13em; }
  .brand-name { color: #1669a5; font-size: 20px; font-weight: 750; letter-spacing: .045em; }
  .corp-header > nav { display: flex; align-items: center; gap: 34px; }
  .corp-header > nav a, .corp-footer nav a { position: relative; color: #526575; font-size: 14px; text-decoration: none; transition: color .2s ease; }
  .corp-header > nav a::after { content: ""; position: absolute; right: 0; bottom: -8px; left: 0; height: 2px; background: #5bcdd3; transform: scaleX(0); transform-origin: left; transition: transform .22s ease; }
  .corp-header > nav a:hover { color: #111f40; }
  .corp-header > nav a:hover::after { transform: scaleX(1); }
  .mobile-menu { display: none; }
  .corp-hero { position: relative; margin: 0 calc((100% - 100vw) / 2); overflow: hidden; color: #f2f6fa; background: #111f40; }
  .corp-hero::before { content: ""; position: absolute; inset: 0 55% 0 0; background: radial-gradient(ellipse at 6% 95%, #1669a544, transparent 58%); pointer-events: none; }
  .hero-inner { position: relative; width: min(1240px, calc(100% - 64px)); min-height: 390px; display: grid; grid-template-columns: 1fr .92fr; align-items: center; gap: 56px; margin: auto; padding: 34px 0; }
  .hero-copy { position: relative; z-index: 2; max-width: 590px; }
  .hero-copy > .eyebrow { animation: rise-in .45s both; }
  .eyebrow { display: flex; align-items: center; gap: 10px; color: #1669a5; font-size: 11px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .eyebrow > span { width: 17px; height: 2px; background: #5bcdd3; }
  .corp-hero .eyebrow { color: #9fdde2; }
  h1, h2, p, figure { margin: 0; }
  .corp-hero h1 { margin-top: 19px; color: #fff; font-size: clamp(38px, 4.5vw, 62px); font-weight: 650; letter-spacing: -.055em; line-height: 1.04; animation: rise-in .5s .08s both; }
  .corp-hero h1 em { color: #5bcdd3; font-style: normal; }
  .hero-description { max-width: 520px; margin-top: 18px; color: #d5deea; font-size: 16px; line-height: 1.65; animation: rise-in .5s .16s both; }
  .hero-link { display: inline-flex; align-items: center; gap: 13px; margin-top: 22px; padding: 13px 17px; border-radius: var(--radius-control); color: #111f40; background: #5bcdd3; font-size: 14px; font-weight: 750; text-decoration: none; transition: background .2s ease, transform .2s ease; animation: rise-in .5s .24s both; }
  .hero-link:hover { transform: translateY(-2px); background: #83e0e3; }
  .hero-visual { position: relative; height: 320px; overflow: hidden; border-radius: var(--radius-media); background: #d7e0e9; animation: rise-in .65s .1s both; }
  .hero-visual::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, #111f4033, transparent 55%), linear-gradient(0deg, #111f4088, transparent 35%); }
  .hero-visual img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center; }
  .hero-visual figcaption { position: absolute; z-index: 1; right: 17px; bottom: 17px; left: 20px; display: flex; align-items: center; gap: 10px; color: #fff; font-size: 11px; font-weight: 650; letter-spacing: .035em; }
  .caption-line { flex: 1; max-width: 38px; height: 1px; background: #5bcdd3; }
  .visual-index { position: absolute; z-index: 1; top: 16px; right: 16px; padding: 8px 10px; color: #fff; background: #111f40dd; font-size: 11px; font-weight: 700; letter-spacing: .08em; }
  .visual-index i { color: #5bcdd3; font-style: normal; }
  .hero-side-note { position: absolute; right: -32px; bottom: 18px; color: #b1c2d6; font-size: 8px; letter-spacing: .2em; writing-mode: vertical-rl; }
  .lines-section { padding: 37px 0 34px; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 19px; }
  .section-heading h2 { margin-top: 7px; color: #111f40; font-size: clamp(27px, 3vw, 38px); font-weight: 650; letter-spacing: -.045em; }
  .section-heading > p { padding: 0 5px 3px 0; color: #526575; font-size: 14px; line-height: 1.55; text-align: right; }
  .business-lines { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 19px; }
  .business-card { position: relative; min-width: 0; min-height: 365px; overflow: hidden; display: flex; align-items: end; border-radius: var(--radius-card); color: #fff; background: #111f40; text-decoration: none; isolation: isolate; box-shadow: 0 2px 8px #111f4014; transition: transform .24s ease, box-shadow .24s ease; }
  @supports (animation-timeline: view()) {
    .business-card { animation: card-reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 32%; }
    .business-card-trust { animation-delay: .08s; }
    @keyframes card-reveal { from { opacity: .55; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  }
  .business-card:focus-visible, .corp-header a:focus-visible, .corp-footer a:focus-visible, .contact-link:focus-visible, .hero-link:focus-visible, .mobile-menu summary:focus-visible { outline: 3px solid #1669a5; outline-offset: 4px; }
  .card-photo, .card-shade { position: absolute; z-index: -1; inset: 0; width: 100%; height: 100%; }
  .card-photo { display: block; object-fit: cover; transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  .card-shade { background: linear-gradient(0deg, #111f40f2 0%, #111f40cc 35%, #111f4040 74%, #111f4030 100%); transition: background .28s ease; }
  .business-card-creative .card-shade { background: linear-gradient(0deg, #111f40f2 0%, #111f40ce 38%, #111f4038 76%, #111f4010 100%); }
  .business-card-trust .card-shade { background: linear-gradient(0deg, #111f40f5 0%, #111f40d8 45%, #111f4048 100%); }
  .business-card:hover, .business-card:focus-visible { transform: translateY(-2px); box-shadow: 0 10px 24px #111f4020; }
  .business-card:hover .card-photo, .business-card:focus-visible .card-photo { transform: scale(1.045); }
  .business-card:hover .card-shade, .business-card:focus-visible .card-shade { background-color: #111f4030; }
  .card-number { position: absolute; top: 20px; left: 22px; color: white; font-size: 15px; font-weight: 750; letter-spacing: .08em; }
  .card-number i { color: #5bcdd3; font-style: normal; }
  .card-content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; width: 100%; padding: 25px 27px 27px; }
  .card-category { margin-bottom: 9px; color: #8de0e3; font-size: 11px; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; }
  .business-title { max-width: 540px; color: #fff; font-size: clamp(19px, 2vw, 26px); font-weight: 700; letter-spacing: -.025em; line-height: 1.19; text-wrap: pretty; }
  .business-description { max-width: 520px; margin-top: 10px; color: #e0e8f0; font-size: 14px; line-height: 1.52; }
  .card-link { display: inline-flex; align-items: center; gap: 11px; margin-top: 15px; color: #fff; font-size: 13px; font-weight: 750; }
  .card-link > span { display: grid; place-items: center; width: 25px; height: 25px; border-radius: 50%; color: #111f40; background: #5bcdd3; font-size: 15px; transition: transform .2s ease; }
  .business-card:hover .card-link > span, .business-card:focus-visible .card-link > span { transform: translate(3px, -2px); }
  .card-arrow { position: absolute; top: 17px; right: 19px; display: grid; place-items: center; width: 39px; height: 39px; border: 1px solid #ffffff80; border-radius: 50%; color: #fff; font-size: 18px; transition: color .2s ease, background .2s ease, border-color .2s ease; }
  .business-card:hover .card-arrow, .business-card:focus-visible .card-arrow { border-color: #5bcdd3; color: #111f40; background: #5bcdd3; }
  .contact-band { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 20px 0 22px; border-top: 1px solid #d7e0e9; }
  .contact-band > div > p { color: #111f40; font-size: 16px; font-weight: 700; }
  .contact-band > div > span { display: block; margin-top: 4px; color: #526575; font-size: 13px; }
  .contact-link { display: inline-flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: var(--radius-control); color: #fff; background: #1669a5; font-size: 13px; font-weight: 700; text-decoration: none; transition: background .2s ease, transform .2s ease; }
  .contact-link:hover { transform: translateY(-2px); background: #111f40; }
  .corp-footer { display: grid; grid-template-columns: 1fr 1fr auto; align-items: center; gap: 20px; padding: 17px 0 23px; border-top: 1px solid #d7e0e9; }
  .footer-brand .brand-investments { font-size: 10px; }
  .footer-brand .brand-name { font-size: 16px; }
  .corp-footer nav { display: flex; flex-wrap: wrap; gap: 15px; }
  .corp-footer nav a { font-size: 12px; }
  .corp-footer > span { color: #526575; font-size: 11px; }
  .skip-link { position: fixed; z-index: 20; top: -100px; left: 20px; padding: 13px 18px; color: #111f40; background: #fff; }
  .skip-link:focus { top: 16px; }
  @keyframes rise-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 980px) {
    .hero-inner { width: min(100% - 48px, 840px); grid-template-columns: 1fr .85fr; gap: 28px; min-height: 370px; }
    .hero-visual { height: 285px; }
    .hero-side-note { display: none; }
    .business-card { min-height: 390px; }
    .card-content { padding-right: 22px; padding-left: 22px; }
  }
  @media (max-width: 760px) {
    .corp-header, main, .corp-footer { width: min(100% - 36px, 620px); }
    .corp-header { height: 72px; }
    .corp-header > nav { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu summary { display: grid; gap: 5px; padding: 10px; cursor: pointer; list-style: none; }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu summary span { width: 23px; border-top: 2px solid #111f40; }
    .mobile-menu nav { position: absolute; z-index: 5; top: 61px; right: 0; display: grid; min-width: 220px; padding: 9px; border: 1px solid #d7e0e9; border-radius: var(--radius-menu); background: #fff; box-shadow: 0 12px 24px #111f4025; }
    .mobile-menu nav a { padding: 12px; color: #111f40; font-weight: 600; text-decoration: none; }
    .hero-inner { width: min(100% - 36px, 620px); grid-template-columns: 1fr; gap: 23px; padding: 34px 0 27px; }
    .corp-hero h1 { margin-top: 16px; font-size: clamp(37px, 9vw, 52px); }
    .hero-description { margin-top: 14px; font-size: 15px; }
    .hero-link { margin-top: 17px; }
    .hero-visual { height: clamp(200px, 57vw, 300px); }
    .lines-section { padding-top: 27px; }
    .section-heading { align-items: flex-start; flex-direction: column; gap: 7px; margin-bottom: 15px; }
    .section-heading > p { text-align: left; }
    .business-lines { grid-template-columns: 1fr; gap: 14px; }
    .business-card { min-height: 355px; }
    .business-title { font-size: clamp(20px, 5.8vw, 26px); }
    .business-description { font-size: 14px; }
    .contact-band { align-items: flex-start; flex-direction: column; gap: 12px; padding: 16px 0 19px; }
    .corp-footer { grid-template-columns: 1fr; gap: 14px; }
    .corp-footer nav { flex-direction: column; gap: 9px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .01ms !important; }
  }
</style>
