---
import Layout from "../layouts/Layout.astro";

const whatsapp = (message: string) =>
  `https://wa.me/51966994027?text=${encodeURIComponent(message)}`;
---

<Layout
  title="ALBERLIC | Soluciones para empresas y personas"
  description="ALBERLIC integra soluciones de comunicación y producción publicitaria, junto con servicios profesionales de evaluación poligráfica y confianza en Perú."
>
  <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
  <div class="corporate-shell">
    <header class="corp-header">
      <a class="brand" href="/" aria-label="ALBERLIC, inicio"
        ><span class="brand-mark" aria-hidden="true"
          ><span></span><span></span><span></span></span
        ><span>ALBERLIC</span></a
      >
      <nav aria-label="Navegación principal">
        <a href="#nosotros">Nosotros</a><a href="#lineas">Líneas de negocio</a
        ><a href="#contacto">Contacto</a>
      </nav>
      <a
        class="header-cta"
        href={whatsapp(
          "Hola, quisiera recibir información sobre los servicios de ALBERLIC.",
        )}
        target="_blank"
        rel="noreferrer">Conversemos <span aria-hidden="true">↗</span></a
      >
      <details class="mobile-menu">
        <summary aria-label="Abrir menú de navegación"
          ><span></span><span></span><span></span></summary
        ><nav aria-label="Navegación móvil">
          <a href="#nosotros">Nosotros</a><a href="#lineas">Líneas de negocio</a
          ><a href="#contacto">Contacto</a>
        </nav>
      </details>
    </header>
    <main id="contenido">
      <section class="corp-hero">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="eyebrow-dot"></span> Una visión, distintas soluciones
          </p><h1>
            Soluciones que conectan <em>ideas, empresas y decisiones.</em>
          </h1><p class="hero-description">
            Integramos comunicación y producción publicitaria con servicios
            profesionales de evaluación poligráfica y confianza.
          </p><a class="button button-primary" href="#lineas"
            >Descubre nuestras líneas <span aria-hidden="true">↓</span></a>
        </div><div class="hero-art" aria-hidden="true">
          <div class="art-orbit orbit-one"></div><div
            class="art-orbit orbit-two"
          >
          </div><div class="art-core">
            <span>ALBERLIC</span><b>Ideas<br />en acción.</b>
          </div><i class="art-node node-one">01</i><i class="art-node node-two"
            >02</i>
        </div>
      </section>
      <section class="lines-section" id="lineas" aria-labelledby="lines-title">
        <div class="section-intro">
          <div>
            <p class="section-kicker">Lo que hacemos</p><h2 id="lines-title">
              Dos líneas<br /><em>Un mismo compromiso</em>
            </h2>
          </div><p>
            Explora cada unidad y encuentra la solución que responde a tu
            necesidad.
          </p>
        </div>
        <div class="business-lines">
          <a
            class="business-card advertising-card"
            href="/comunicacion-publicitaria/"
            ><span class="line-top"
              ><span>01 / COMUNICACIÓN</span><span
                class="line-icon"
                aria-hidden="true">✳</span
              ></span
            ><span class="business-title"
              >Soluciones integrales de comunicación y producción publicitaria</span
            ><span class="business-description"
              >Estrategia, identidad de marca, publicidad y producción de
              materiales para comunicar con claridad.</span
            ><span class="card-link"
              >Explorar servicios <b aria-hidden="true">↗</b></span
            ><span class="card-decoration" aria-hidden="true">A—Z</span></a
          >
          <a class="business-card evaluation-card" href="/poligrafo/"
            ><span class="line-top"
              ><span>02 / EVALUACIÓN</span><span
                class="line-icon"
                aria-hidden="true">⌁</span
              ></span
            ><span class="business-title"
              >Evaluación profesional y servicios de confianza</span
            ><span class="business-description"
              >Pruebas de polígrafo y evaluación poligráfica para personas y
              organizaciones, con un enfoque responsable.</span
            ><span class="card-link"
              >Conocer servicios <b aria-hidden="true">↗</b></span
            ><span class="card-decoration" aria-hidden="true">02</span></a
          >
        </div>
      </section>
      <section class="about-section" id="nosotros">
        <div class="about-mark" aria-hidden="true">A<span>.</span></div><div>
          <p class="section-kicker">ALBERLIC</p><h2>
            Soluciones claras para <em>necesidades distintas.</em>
          </h2><p>
            Reunimos dos áreas de trabajo independientes bajo una misma marca:
            comunicación para impulsar ideas y servicios de evaluación
            poligráfica para abordar situaciones que requieren confianza y
            claridad.
          </p>
        </div>
      </section>
      <section class="contact-band" id="contacto">
        <div>
          <p class="section-kicker">¿Conversamos?</p><h2>
            Cuéntanos qué estás buscando.
          </h2>
        </div><a
          class="button button-primary"
          href={whatsapp(
            "Hola, quisiera recibir información sobre las líneas de negocio de ALBERLIC.",
          )}
          target="_blank"
          rel="noreferrer"
          >Contactar por WhatsApp <span aria-hidden="true">↗</span></a>
      </section>
    </main>
    <footer class="corp-footer">
      <a class="brand" href="/" aria-label="ALBERLIC, inicio"
        ><span class="brand-mark" aria-hidden="true"
          ><span></span><span></span><span></span></span
        ><span>ALBERLIC</span></a
      ><nav aria-label="Líneas de negocio">
        <a href="/comunicacion-publicitaria/">Comunicación publicitaria</a><a
          href="/poligrafo/">Evaluación poligráfica</a>
      </nav><span>© 2026 ALBERLIC. Todos los derechos reservados.</span>
    </footer>
  </div>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    margin: 0;
    background: #f4f1e9;
    color: #172422;
    font-family: "DM Sans", Arial, sans-serif;
  }
  :global(a) {
    color: inherit;
  }
  .corporate-shell {
    overflow: clip;
  }
  .corp-header,
  main,
  .corp-footer {
    width: min(1180px, calc(100% - 64px));
    margin: auto;
  }
  .corp-header {
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #1724222e;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.05em;
    text-decoration: none;
  }
  .brand-mark {
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: end;
    justify-content: center;
    gap: 3px;
    padding: 5px;
    border-radius: 7px;
    background: #d7f35a;
    transform: rotate(-8deg);
  }
  .brand-mark span {
    width: 3px;
    background: #172422;
    border-radius: 3px;
    transform: rotate(8deg);
  }
  .brand-mark span:nth-child(1) {
    height: 7px;
  }
  .brand-mark span:nth-child(2) {
    height: 12px;
  }
  .brand-mark span:nth-child(3) {
    height: 16px;
  }
  .corp-header nav {
    display: flex;
    gap: 30px;
    margin-left: auto;
    margin-right: 34px;
  }
  .corp-header nav a,
  .corp-footer nav a {
    font-size: 14px;
    text-decoration: none;
    color: #495650;
  }
  .corp-header nav a:hover,
  .corp-footer nav a:hover {
    color: #718b0c;
  }
  .header-cta,
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    border-radius: 100px;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }
  .header-cta {
    padding: 14px 19px;
    color: #f6f3ea;
    background: #172422;
  }
  .header-cta:hover,
  .button:hover {
    transform: translateY(-2px);
  }
  .mobile-menu {
    display: none;
  }
  .corp-hero {
    min-height: 640px;
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    align-items: center;
    gap: 60px;
    padding: 78px 0;
  }
  .eyebrow,
  .section-kicker {
    color: #596b13;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #91ae16;
    box-shadow: 0 0 0 4px #e0e9b7;
  }
  h1,
  h2,
  p {
    margin: 0;
  }
  .corp-hero h1,
  .section-intro h2,
  .about-section h2,
  .contact-band h2 {
    font:
      500 clamp(48px, 6vw, 78px)/0.99 "DM Serif Display",
      Georgia,
      serif;
    letter-spacing: -0.052em;
  }
  .corp-hero h1 {
    max-width: 660px;
    margin: 25px 0;
  }
  .corp-hero h1 em,
  h2 em {
    color: #829e14;
    font-style: normal;
  }
  .hero-description {
    max-width: 530px;
    color: #45534c;
    font-size: 18px;
    line-height: 1.65;
    margin-bottom: 31px;
  }
  .button {
    padding: 18px 23px;
  }
  .button-primary {
    color: #172422;
    background: #d7f35a;
  }
  .hero-art {
    height: 450px;
    position: relative;
    display: grid;
    place-items: center;
  }
  .art-orbit {
    position: absolute;
    border: 1px solid #aabb73;
    border-radius: 50%;
    transform: rotate(-28deg);
  }
  .orbit-one {
    width: 410px;
    height: 300px;
  }
  .orbit-two {
    width: 300px;
    height: 410px;
    transform: rotate(42deg);
    border-color: #d0d8b8;
  }
  .art-core {
    width: 235px;
    height: 235px;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 18px;
    color: #eaf0df;
    background: #1b2926;
    box-shadow: 0 25px 55px #17242226;
    transform: rotate(-8deg);
  }
  .art-core span {
    font-size: 12px;
    letter-spacing: 0.2em;
    color: #d7f35a;
  }
  .art-core b {
    font:
      500 35px/0.98 "DM Serif Display",
      Georgia,
      serif;
    text-align: center;
  }
  .art-node {
    position: absolute;
    display: grid;
    place-items: center;
    width: 53px;
    height: 53px;
    border: 1px solid #d5dbbd;
    border-radius: 50%;
    background: #f4f1e9;
    color: #65780e;
    font-style: normal;
    font-weight: 700;
  }
  .node-one {
    top: 50px;
    left: 15%;
  }
  .node-two {
    right: 10%;
    bottom: 54px;
  }
  .lines-section {
    padding: 78px 0 130px;
    border-top: 1px solid #17242224;
  }
  .section-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 35px;
    margin-bottom: 43px;
  }
  .section-intro h2,
  .about-section h2 {
    font-size: clamp(42px, 4.7vw, 62px);
    margin-top: 18px;
  }
  .section-intro > p {
    max-width: 340px;
    color: #506057;
    font-size: 16px;
    line-height: 1.65;
  }
  .business-lines {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .business-card {
    position: relative;
    min-height: 410px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 34px;
    border: 1px solid #17242220;
    border-radius: 12px;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .business-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 45px #17242214;
  }
  .business-card:focus-visible,
  .corp-header a:focus-visible,
  .corp-footer a:focus-visible {
    outline: 3px solid #778f0e;
    outline-offset: 4px;
  }
  .advertising-card {
    background: #e9e6dd;
  }
  .evaluation-card {
    color: #eef1e5;
    background: #1b2926;
  }
  .line-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.13em;
    opacity: 0.8;
  }
  .line-icon {
    display: grid;
    place-items: center;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    color: #60770c;
    background: #d9e6a9;
    font-size: 23px;
    letter-spacing: 0;
  }
  .evaluation-card .line-icon {
    color: #d7f35a;
    background: #314238;
  }
  .business-title {
    position: relative;
    z-index: 1;
    max-width: 480px;
    margin-top: 42px;
    font:
      500 clamp(31px, 3.2vw, 43px)/1.06 "DM Serif Display",
      Georgia,
      serif;
    letter-spacing: -0.035em;
  }
  .business-description {
    position: relative;
    z-index: 1;
    max-width: 410px;
    margin-top: 17px;
    color: #526159;
    font-size: 15px;
    line-height: 1.6;
  }
  .evaluation-card .business-description {
    color: #c0cbc0;
  }
  .card-link {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 28px;
    font-size: 14px;
    font-weight: 700;
  }
  .card-link b {
    font-size: 19px;
  }
  .card-decoration {
    position: absolute;
    right: 24px;
    bottom: -35px;
    color: #1724220a;
    font:
      700 140px/0.9 "DM Sans",
      sans-serif;
    letter-spacing: -0.1em;
  }
  .evaluation-card .card-decoration {
    color: #ffffff08;
  }
  .about-section {
    display: grid;
    grid-template-columns: 0.6fr 1.4fr;
    align-items: center;
    gap: 75px;
    padding: 100px 8%;
    background: #e9e6dd;
    margin: 0 calc((100vw - min(1180px, calc(100vw - 64px))) / -2);
  }
  .about-mark {
    font:
      500 190px/0.8 "DM Serif Display",
      Georgia,
      serif;
    letter-spacing: -0.12em;
    color: #1b2926;
  }
  .about-mark span {
    color: #91ae16;
  }
  .about-section h2 {
    max-width: 700px;
  }
  .about-section p:last-child {
    max-width: 690px;
    margin-top: 22px;
    color: #4f5d55;
    font-size: 17px;
    line-height: 1.7;
  }
  .contact-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    padding: 88px 5%;
    margin: 80px 0;
    border-radius: 12px;
    color: #eef1e5;
    background: #1b2926;
  }
  .contact-band .section-kicker {
    color: #b8ca6b;
  }
  .contact-band h2 {
    max-width: 600px;
    margin-top: 17px;
    font-size: clamp(39px, 4.4vw, 58px);
  }
  .corp-footer {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: center;
    gap: 28px;
    padding: 0 0 35px;
  }
  .corp-footer nav {
    display: flex;
    gap: 20px;
  }
  .corp-footer > span {
    color: #617067;
    font-size: 12px;
  }
  .skip-link {
    position: fixed;
    z-index: 20;
    top: -100px;
    left: 20px;
    padding: 13px 18px;
    border-radius: 8px;
    background: #d7f35a;
    font-weight: 700;
  }
  .skip-link:focus {
    top: 16px;
  }
  @media (max-width: 800px) {
    .corp-header,
    main,
    .corp-footer {
      width: min(100% - 38px, 600px);
    }
    .corp-header {
      height: 79px;
    }
    .corp-header > nav,
    .header-cta {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .mobile-menu summary {
      display: grid;
      gap: 4px;
      padding: 11px;
      cursor: pointer;
      list-style: none;
    }
    .mobile-menu summary span {
      width: 23px;
      border-top: 2px solid #172422;
    }
    .mobile-menu nav {
      position: absolute;
      z-index: 5;
      top: 66px;
      right: 19px;
      display: grid;
      width: 225px;
      padding: 12px;
      border: 1px solid #ccd3c9;
      border-radius: 9px;
      background: #f9f7f1;
      box-shadow: 0 14px 28px #1724221f;
    }
    .mobile-menu nav a {
      padding: 12px;
      font-weight: 700;
      text-decoration: none;
    }
    .corp-hero {
      grid-template-columns: 1fr;
      gap: 5px;
      padding: 65px 0;
    }
    .hero-art {
      height: 350px;
    }
    .orbit-one {
      width: min(90%, 370px);
      height: 270px;
    }
    .orbit-two {
      width: 270px;
      height: 350px;
    }
    .lines-section {
      padding: 65px 0 85px;
    }
    .section-intro {
      display: block;
    }
    .section-intro > p {
      margin-top: 20px;
    }
    .business-lines {
      grid-template-columns: 1fr;
    }
    .business-card {
      min-height: 365px;
      padding: 27px;
    }
    .business-title {
      margin-top: 32px;
    }
    .about-section {
      grid-template-columns: 1fr;
      gap: 28px;
      margin: 0 -19px;
      padding: 65px 19px;
    }
    .about-mark {
      font-size: 120px;
    }
    .contact-band {
      align-items: flex-start;
      flex-direction: column;
      padding: 55px 25px;
      margin: 55px 0;
    }
    .corp-footer {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-bottom: 100px;
    }
    .corp-footer nav {
      flex-direction: column;
      gap: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
    .business-card,
    .button,
    .header-cta {
      transition: none;
    }
  }
</style>
