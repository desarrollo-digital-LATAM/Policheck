---
import Layout from "../layouts/Layout.astro";

const whatsapp = (message: string) =>
  `https://wa.me/51966994027?text=${encodeURIComponent(message)}`;
---

<Layout
  title="INVERSIONES ALBERLIC | Nuestras líneas de negocio"
  description="Conoce las líneas de negocio de INVERSIONES ALBERLIC: soluciones de comunicación y producción publicitaria, y servicios confirmados de evaluación poligráfica y de confianza."
  ogImageAlt="INVERSIONES ALBERLIC — Nuestras líneas de negocio"
>
  <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
  <div class="corporate-shell">
    <header class="corp-header">
      <a class="brand" href="/" aria-label="INVERSIONES ALBERLIC, inicio">
        <span class="brand-investments">INVERSIONES</span><span class="brand-name">ALBERLIC</span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="/">Inicio</a><a href="#lineas">Líneas de negocio</a><a href="#contacto">Contacto</a>
      </nav>
      <details class="mobile-menu">
        <summary aria-label="Abrir menú de navegación"><span></span><span></span><span></span></summary>
        <nav aria-label="Navegación móvil">
          <a href="/">Inicio</a><a href="#lineas">Líneas de negocio</a><a href="#contacto">Contacto</a>
        </nav>
      </details>
    </header>

    <main id="contenido">
      <section class="corp-hero" aria-labelledby="page-title">
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="eyebrow"><span></span> INVERSIONES ALBERLIC</p>
            <h1 id="page-title">Nuestras líneas<br /><em>de negocio</em></h1>
            <p class="hero-description">Conoce nuestras áreas de especialización y encuentra la solución que mejor responde a tu necesidad.</p>
            <a class="hero-link" href="#lineas">Conocer las líneas <span aria-hidden="true">↓</span></a>
          </div>
          <figure class="hero-visual">
            <img src="/images/alberlic-hero.jpg" alt="Muestras de color, herramientas y materiales de diseño gráfico sobre una mesa" fetchpriority="high" width="1500" height="1000" />
            <figcaption>Comunicación y soluciones para organizaciones</figcaption>
          </figure>
        </div>
      </section>

      <section class="lines-section" id="lineas" aria-labelledby="lines-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span></span> INVERSIONES ALBERLIC</p>
            <h2 id="lines-title">Nuestras líneas de negocio</h2>
          </div>
          <p>Dos áreas especializadas, presentadas con claridad.</p>
        </div>

        <article class="business-line line-creative" aria-labelledby="creative-title">
          <div class="line-copy">
            <p class="line-kicker"><span>01</span> Comunicación &amp; producción</p>
            <h3 id="creative-title">SOLUCIONES INTEGRALES DE COMUNICACIÓN Y PRODUCCIÓN PUBLICITARIA</h3>
            <p class="line-description">Propuestas de comunicación, creatividad, identidad visual y producción publicitaria para marcas, empresas y diferentes necesidades comerciales.</p>
            <ul class="service-tags" aria-label="Áreas de servicio">
              <li>Creatividad</li><li>Identidad visual</li><li>Producción gráfica</li>
            </ul>
            <a class="line-cta" href="/comunicacion-publicitaria/">Explorar servicios <span aria-hidden="true">↗</span></a>
          </div>
          <a class="brochure brochure-creative" href="/comunicacion-publicitaria/" aria-label="Ver servicios de comunicación y producción publicitaria">
            <img class="brochure-main" src="/images/alberlic-comunicacion.jpg" alt="Muestras de color y materiales para diseño gráfico" loading="lazy" width="1200" height="936" />
            <span class="brochure-shade" aria-hidden="true"></span>
            <span class="brochure-label">COMUNICACIÓN / 01</span>
            <span class="brochure-caption"><b>De la idea<br />a la expresión visual.</b><span>Creatividad · Diseño · Producción</span></span>
            <span class="brochure-detail" aria-hidden="true"><img src="/images/alberlic-hero.jpg" alt="" loading="lazy" width="1500" height="1000" /><span>CREATIVIDAD<br />EN CADA FORMATO</span></span>
            <span class="brochure-open" aria-hidden="true">↗</span>
          </a>
        </article>

        <article class="business-line line-evaluation" aria-labelledby="evaluation-title">
          <a class="brochure brochure-evaluation" href="/poligrafo/" aria-label="Conocer servicios de evaluación poligráfica y confianza">
            <img class="brochure-main" src="/images/alberlic-evaluacion.jpg" alt="Conversación profesional en un entorno de oficina" loading="lazy" width="1200" height="675" />
            <span class="brochure-shade" aria-hidden="true"></span>
            <span class="brochure-label">EVALUACIÓN / 02</span>
            <span class="brochure-caption"><b>Un proceso claro,<br />con criterio profesional.</b><span>Evaluación poligráfica · Confianza</span></span>
            <span class="brochure-note"><span class="note-mark" aria-hidden="true">02</span><span>Atención a personas<br />y organizaciones</span></span>
            <span class="brochure-open" aria-hidden="true">↗</span>
          </a>
          <div class="line-copy">
            <p class="line-kicker"><span>02</span> Evaluación &amp; confianza</p>
            <h3 id="evaluation-title">SERVICIOS ESPECIALIZADOS DE EVALUACIÓN, INTELIGENCIA CORPORATIVA Y GESTIÓN DE RIESGOS</h3>
            <p class="line-description">Servicios de evaluación poligráfica y de confianza orientados a personas y organizaciones que requieren procesos con mayor claridad y criterio profesional.</p>
            <p class="confirmation-note">Consulta sobre nuestros servicios de evaluación poligráfica.</p>
            <a class="line-cta" href="/poligrafo/">Conocer servicios <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      </section>

      <section class="contact-band" id="contacto" aria-label="Contacto">
        <div><p>¿Tienes una consulta?</p><span>Estamos a un mensaje de distancia.</span></div>
        <a class="contact-link" href={whatsapp("Hola, quisiera recibir información sobre las líneas de negocio de INVERSIONES ALBERLIC.")} target="_blank" rel="noreferrer">Conversemos por WhatsApp <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer class="corp-footer">
      <a class="brand footer-brand" href="/" aria-label="INVERSIONES ALBERLIC, inicio"><span class="brand-investments">INVERSIONES</span><span class="brand-name">ALBERLIC</span></a>
      <nav aria-label="Líneas de negocio"><a href="/comunicacion-publicitaria/">Comunicación y producción publicitaria</a><a href="/poligrafo/">Evaluación poligráfica</a></nav>
      <span>© 2026 INVERSIONES ALBERLIC</span>
    </footer>
  </div>
</Layout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #f2f6fa; color: #111f40; font-family: "DM Sans", Arial, sans-serif; }
  :global(a) { color: inherit; }
  .corporate-shell { --radius-card: 16px; --radius-media: 15px; --radius-control: 9px; --radius-menu: 9px; overflow: clip; }
  .corp-header, main, .corp-footer { width: min(1240px, calc(100% - 64px)); margin: auto; }
  .corp-header { position: relative; z-index: 4; height: 78px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #d7e0e9; }
  .brand { display: inline-flex; align-items: baseline; gap: 8px; color: #111f40; text-decoration: none; white-space: nowrap; }
  .brand-investments { font-size: 12px; font-weight: 500; letter-spacing: .13em; }
  .brand-name { color: #1669a5; font-size: 20px; font-weight: 750; letter-spacing: .045em; }
  .corp-header > nav { display: flex; align-items: center; gap: 34px; }
  .corp-header > nav a, .corp-footer nav a { position: relative; color: #526575; font-size: 14px; text-decoration: none; transition: color .2s ease; }
  .corp-header > nav a::after { content: ""; position: absolute; right: 0; bottom: -8px; left: 0; height: 2px; background: #5bcdd3; transform: scaleX(0); transform-origin: left; transition: transform .22s ease; }
  .corp-header > nav a:hover { color: #111f40; }
  .corp-header > nav a:hover::after { transform: scaleX(1); }
  .mobile-menu { display: none; }
  .corp-hero { position: relative; margin: 0 calc((100% - 100vw) / 2); overflow: hidden; color: #f2f6fa; background: #111f40; }
  .corp-hero::before { content: ""; position: absolute; inset: 0 55% 0 0; background: radial-gradient(ellipse at 6% 95%, #1669a544, transparent 58%); pointer-events: none; }
  .hero-inner { position: relative; width: min(1240px, calc(100% - 64px)); min-height: 322px; display: grid; grid-template-columns: 1fr .72fr; align-items: center; gap: 70px; margin: auto; padding: 29px 0; }
  .hero-copy { position: relative; z-index: 2; max-width: 620px; }
  .hero-copy > .eyebrow { animation: rise-in .45s both; }
  .eyebrow { display: flex; align-items: center; gap: 10px; color: #1669a5; font-size: 11px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .eyebrow > span { width: 17px; height: 2px; background: #5bcdd3; }
  .corp-hero .eyebrow { color: #9fdde2; }
  h1, h2, h3, p, figure { margin: 0; }
  .corp-hero h1 { margin-top: 16px; color: #fff; font-size: clamp(40px, 5vw, 64px); font-weight: 650; letter-spacing: -.055em; line-height: 1.02; animation: rise-in .5s .08s both; }
  .corp-hero h1 em { color: #5bcdd3; font-style: normal; }
  .hero-description { max-width: 490px; margin-top: 15px; color: #d5deea; font-size: 16px; line-height: 1.6; animation: rise-in .5s .16s both; }
  .hero-link { display: inline-flex; align-items: center; gap: 13px; margin-top: 19px; padding: 12px 16px; border-radius: var(--radius-control); color: #111f40; background: #5bcdd3; font-size: 14px; font-weight: 750; text-decoration: none; transition: background .2s ease, transform .2s ease; animation: rise-in .5s .24s both; }
  .hero-link:hover { transform: translateY(-2px); background: #83e0e3; }
  .hero-visual { position: relative; height: 245px; overflow: hidden; border-radius: var(--radius-media); background: #d7e0e9; animation: rise-in .65s .1s both; }
  .hero-visual::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, #111f4033, transparent 55%), linear-gradient(0deg, #111f4088, transparent 35%); }
  .hero-visual img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center; }
  .hero-visual figcaption { position: absolute; z-index: 1; right: 16px; bottom: 15px; left: 17px; color: #fff; font-size: 11px; font-weight: 650; letter-spacing: .035em; }
  .lines-section { padding: 48px 0 28px; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 16px; }
  .section-heading h2 { margin-top: 7px; color: #111f40; font-size: clamp(29px, 3.4vw, 42px); font-weight: 650; letter-spacing: -.045em; }
  .section-heading > p { padding: 0 5px 4px 0; color: #526575; font-size: 14px; line-height: 1.55; }
  .business-line { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); align-items: center; gap: clamp(34px, 6vw, 82px); padding: 42px 0; border-top: 1px solid #d7e0e9; }
  .line-evaluation { grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); }
  @supports (animation-timeline: view()) {
    .business-line { animation: line-reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 24%; }
    @keyframes line-reveal { from { opacity: .55; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
  }
  .line-copy { padding: 8px 0; }
  .line-kicker { display: flex; align-items: center; gap: 11px; margin-bottom: 16px; color: #1669a5; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .line-kicker span { color: #111f40; font-size: 15px; letter-spacing: .04em; }
  .line-copy h3 { max-width: 570px; color: #111f40; font-size: clamp(24px, 2.8vw, 35px); font-weight: 700; letter-spacing: -.04em; line-height: 1.13; text-wrap: pretty; }
  .line-description { max-width: 530px; margin-top: 16px; color: #526575; font-size: 16px; line-height: 1.7; }
  .service-tags { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 17px 0 0; list-style: none; }
  .service-tags li { padding: 7px 10px; border: 1px solid #cfdae5; border-radius: 6px; color: #526575; background: #fff; font-size: 12px; }
  .line-cta { display: inline-flex; align-items: center; gap: 12px; margin-top: 22px; padding: 12px 16px; border-radius: var(--radius-control); color: #fff; background: #1669a5; font-size: 14px; font-weight: 700; text-decoration: none; transition: background .2s ease, transform .2s ease; }
  .line-cta:hover { transform: translateY(-2px); background: #111f40; }
  .line-cta:focus-visible, .brochure:focus-visible, .corp-header a:focus-visible, .corp-footer a:focus-visible, .contact-link:focus-visible, .hero-link:focus-visible, .mobile-menu summary:focus-visible { outline: 3px solid #1669a5; outline-offset: 4px; }
  .confirmation-note { margin-top: 15px; padding-left: 13px; border-left: 2px solid #5bcdd3; color: #526575; font-size: 13px; line-height: 1.55; }
  .brochure { position: relative; min-width: 0; height: clamp(310px, 34vw, 420px); overflow: hidden; display: block; border: 1px solid #d7e0e9; border-radius: var(--radius-card); color: #fff; background: #111f40; text-decoration: none; isolation: isolate; box-shadow: 0 8px 28px #111f4012; }
  .brochure-main, .brochure-shade { position: absolute; z-index: -1; inset: 0; width: 100%; height: 100%; }
  .brochure-main { display: block; object-fit: cover; transition: transform .55s cubic-bezier(.2,.7,.2,1); }
  .brochure-shade { background: linear-gradient(0deg, #111f40ed 0%, #111f4082 35%, #111f4012 80%); }
  .brochure-creative .brochure-main { object-position: center 56%; }
  .brochure-evaluation .brochure-main { object-position: center 44%; }
  .brochure-creative .brochure-shade { background: linear-gradient(0deg, #111f40e8 0%, #111f406e 37%, #111f4010 79%); }
  .brochure-label { position: absolute; top: 18px; left: 20px; padding: 8px 10px; border: 1px solid #ffffff85; border-radius: 4px; color: #fff; background: #111f403d; font-size: 10px; font-weight: 700; letter-spacing: .13em; }
  .brochure-caption { position: absolute; right: 20px; bottom: 21px; left: 23px; display: flex; flex-direction: column; gap: 10px; }
  .brochure-caption b { font-size: clamp(24px, 3vw, 36px); font-weight: 650; letter-spacing: -.04em; line-height: 1.08; }
  .brochure-caption > span { color: #dce8f0; font-size: 12px; letter-spacing: .04em; }
  .brochure-detail { position: absolute; top: 20px; right: 19px; width: 29%; height: 36%; overflow: hidden; border: 4px solid #f2f6fa; border-radius: 8px; background: #f2f6fa; box-shadow: 0 8px 22px #111f4033; transform: rotate(2deg); }
  .brochure-detail img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .brochure-detail > span { position: absolute; right: 0; bottom: 0; left: 0; padding: 6px; color: #fff; background: #111f40c9; font-size: 8px; font-weight: 700; letter-spacing: .09em; line-height: 1.4; }
  .brochure-note { position: absolute; top: 20px; right: 20px; display: flex; align-items: center; gap: 10px; padding: 10px 13px; border: 1px solid #ffffff70; border-radius: 7px; color: #fff; background: #111f408c; font-size: 11px; line-height: 1.45; backdrop-filter: blur(5px); }
  .note-mark { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; color: #111f40; background: #5bcdd3; font-size: 11px; font-weight: 700; }
  .brochure-open { position: absolute; right: 20px; bottom: 20px; display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid #ffffff9c; border-radius: 50%; color: #fff; font-size: 17px; transition: color .2s ease, background .2s ease, border-color .2s ease; }
  .brochure:hover .brochure-main, .brochure:focus-visible .brochure-main { transform: scale(1.035); }
  .brochure:hover .brochure-open, .brochure:focus-visible .brochure-open { border-color: #5bcdd3; color: #111f40; background: #5bcdd3; }
  .contact-band { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 20px 0 22px; border-top: 1px solid #d7e0e9; }
  .contact-band > div > p { color: #111f40; font-size: 16px; font-weight: 700; }
  .contact-band > div > span { display: block; margin-top: 4px; color: #526575; font-size: 13px; }
  .contact-link { display: inline-flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: var(--radius-control); color: #fff; background: #1669a5; font-size: 13px; font-weight: 700; text-decoration: none; transition: background .2s ease, transform .2s ease; }
  .contact-link:hover { transform: translateY(-2px); background: #111f40; }
  .corp-footer { display: grid; grid-template-columns: 1fr 1fr auto; align-items: center; gap: 20px; padding: 17px 0 23px; border-top: 1px solid #d7e0e9; }
  .footer-brand .brand-investments { font-size: 10px; }
  .footer-brand .brand-name { font-size: 16px; }
  .corp-footer nav { display: flex; flex-wrap: wrap; gap: 15px; }
  .corp-footer nav a { font-size: 12px; }
  .corp-footer > span { color: #526575; font-size: 11px; }
  .skip-link { position: fixed; z-index: 20; top: -100px; left: 20px; padding: 13px 18px; color: #111f40; background: #fff; }
  .skip-link:focus { top: 16px; }
  @keyframes rise-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 980px) {
    .hero-inner { width: min(100% - 48px, 840px); grid-template-columns: 1fr .72fr; gap: 34px; min-height: 300px; }
    .hero-visual { height: 215px; }
    .business-line, .line-evaluation { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; }
    .brochure { height: 350px; }
    .line-copy h3 { font-size: clamp(22px, 3vw, 30px); }
  }
  @media (max-width: 760px) {
    .corp-header, main, .corp-footer { width: min(100% - 36px, 620px); }
    .corp-header { height: 72px; }
    .corp-header > nav { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu summary { display: grid; gap: 5px; padding: 10px; cursor: pointer; list-style: none; }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu summary span { width: 23px; border-top: 2px solid #111f40; }
    .mobile-menu nav { position: absolute; z-index: 5; top: 61px; right: 0; display: grid; min-width: 220px; padding: 9px; border: 1px solid #d7e0e9; border-radius: var(--radius-menu); background: #fff; box-shadow: 0 12px 24px #111f4025; }
    .mobile-menu nav a { padding: 12px; color: #111f40; font-weight: 600; text-decoration: none; }
    .hero-inner { width: min(100% - 36px, 620px); grid-template-columns: 1fr; gap: 19px; min-height: 0; padding: 31px 0 25px; }
    .corp-hero h1 { margin-top: 13px; font-size: clamp(37px, 9vw, 52px); }
    .hero-description { max-width: 490px; margin-top: 11px; font-size: 15px; }
    .hero-link { margin-top: 14px; }
    .hero-visual { height: clamp(165px, 49vw, 245px); }
    .lines-section { padding-top: 31px; }
    .section-heading { align-items: flex-start; flex-direction: column; gap: 5px; margin-bottom: 13px; }
    .section-heading > p { text-align: left; }
    .business-line, .line-evaluation { grid-template-columns: 1fr; gap: 20px; padding: 27px 0 31px; }
    .line-evaluation .brochure { grid-row: 2; }
    .line-evaluation .line-copy { grid-row: 1; }
    .line-copy { padding: 0; }
    .line-kicker { margin-bottom: 12px; }
    .line-copy h3 { max-width: 580px; font-size: clamp(23px, 6.2vw, 32px); }
    .line-description { margin-top: 12px; font-size: 15px; }
    .line-cta { margin-top: 17px; }
    .brochure { height: clamp(270px, 75vw, 380px); }
    .brochure-detail { width: 28%; height: 34%; }
    .brochure-note { top: 16px; right: 15px; }
    .contact-band { align-items: flex-start; flex-direction: column; gap: 12px; padding: 16px 0 19px; }
    .corp-footer { grid-template-columns: 1fr; gap: 14px; }
    .corp-footer nav { flex-direction: column; gap: 9px; }
  }
  @media (max-width: 420px) {
    .brand { gap: 6px; }
    .brand-investments { font-size: 10px; }
    .brand-name { font-size: 18px; }
    .brochure-caption { right: 15px; bottom: 17px; left: 17px; }
    .brochure-caption b { font-size: 25px; }
    .brochure-caption > span { max-width: 230px; font-size: 11px; line-height: 1.4; }
    .brochure-detail { top: 16px; right: 15px; width: 31%; height: 32%; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .01ms !important; }
  }
</style>
