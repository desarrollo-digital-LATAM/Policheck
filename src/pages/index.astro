---
import ContactForm from "../components/ContactForm";
import Layout from "../layouts/Layout.astro";

const whatsapp = (message: string) =>
  `https://wa.me/51966994027?text=${encodeURIComponent(message)}`;
const services = [
  [
    "Polígrafo para selección de personal",
    "Una herramienta complementaria para determinados procesos de selección, según el caso y su viabilidad.",
    "◒",
  ],
  [
    "Polígrafo específico",
    "Una evaluación orientada a revisar una situación o hecho concreto dentro de un procedimiento estructurado.",
    "◎",
  ],
  [
    "Evaluación para empresas",
    "Para organizaciones que desean conversar sobre necesidades relacionadas con confianza y evaluación.",
    "◫",
  ],
  [
    "Consulta personalizada",
    "Un primer espacio para orientar qué tipo de evaluación podría corresponder a tu necesidad.",
    "↗",
  ],
];
const faq = [
  [
    "¿Qué es una prueba de polígrafo?",
    "Es una herramienta de evaluación que combina una entrevista estructurada con el registro de determinadas respuestas fisiológicas durante preguntas previamente revisadas. Sus resultados se interpretan dentro del procedimiento correspondiente.",
  ],
  [
    "¿Cómo funciona el polígrafo?",
    "Antes de la evaluación se explica el proceso y se revisan los temas a tratar. Durante la sesión, el equipo registra variables fisiológicas mientras la persona responde las preguntas acordadas. Posteriormente, los registros se analizan según el procedimiento.",
  ],
  [
    "¿Qué variables fisiológicas se registran?",
    "El equipo puede registrar variables fisiológicas relacionadas con la respiración, la actividad cardiovascular y la respuesta electrodérmica. El alcance concreto debe explicarse antes de la evaluación.",
  ],
  [
    "¿Cuánto dura una evaluación?",
    "La duración puede variar según el tipo de evaluación, la entrevista previa y las características del caso. En muchos procedimientos completos, puede extenderse aproximadamente entre 90 y 120 minutos.",
  ],
  [
    "¿La evaluación es voluntaria?",
    "Una evaluación responsable comienza con información previa y consentimiento. La persona debe conocer el procedimiento y las condiciones antes de decidir si participa.",
  ],
  [
    "¿Qué ocurre durante la entrevista previa?",
    "Se explica el procedimiento, se aclaran dudas y se revisan los temas que serán evaluados. Esta etapa ayuda a que las preguntas sean comprendidas antes de iniciar el registro.",
  ],
  [
    "¿Qué tipo de preguntas se realizan?",
    "Las preguntas se definen según el objetivo de la evaluación y deben ser claras, pertinentes y previamente explicadas dentro del procedimiento.",
  ],
  [
    "¿Puedo solicitar una evaluación para un caso específico?",
    "Sí. Puedes explicar tu situación para recibir una orientación inicial. La viabilidad y el enfoque dependen de las características de cada caso.",
  ],
  [
    "¿Las empresas pueden solicitar evaluaciones?",
    "Las organizaciones pueden consultar sobre evaluaciones como herramienta complementaria para determinados procesos. Conviene revisar previamente la pertinencia y condiciones aplicables al caso.",
  ],
  [
    "¿La información es confidencial?",
    "La información proporcionada durante el proceso debe tratarse de manera responsable y reservada, de acuerdo con las condiciones informadas al cliente.",
  ],
  [
    "¿Qué información necesito para solicitar una evaluación?",
    "Los requisitos pueden variar. Durante la consulta inicial se puede indicar qué información es pertinente para comprender el caso y preparar la evaluación.",
  ],
  [
    "¿El resultado es inmediato?",
    "La comunicación del resultado depende de las condiciones del servicio y del análisis posterior de los registros obtenidos.",
  ],
  [
    "¿Cuánto cuesta una evaluación?",
    "El costo depende del tipo de evaluación y de las características del caso. Comunícate con POLICHECK para recibir información.",
  ],
];
---

<Layout
  title="POLICHECK | Pruebas de Polígrafo y Evaluación de Confianza"
  description="Conoce los servicios de POLICHECK para pruebas de polígrafo y evaluación poligráfica en Perú. Atención profesional, confidencial y personalizada."
>
  <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
  <div class="page-shell">
    <header class="site-header">
      <a class="brand" href="/" aria-label="POLICHECK, inicio"
        ><span class="brand-mark" aria-hidden="true"
          ><span></span><span></span><span></span></span
        ><span>POLICHECK</span></a
      >
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#servicios">Servicios</a><a href="#como-funciona"
          >Cómo funciona</a
        ><a href="#para-quien">Para quién</a><a href="#preguntas"
          >Preguntas frecuentes</a>
      </nav>
      <a
        class="header-cta"
        href={whatsapp(
          "Hola, quisiera recibir información sobre los servicios de POLICHECK",
        )}
        target="_blank"
        rel="noreferrer">WhatsApp <span aria-hidden="true">↗</span></a
      >
      <details class="mobile-menu">
        <summary aria-label="Abrir menú de navegación"
          ><span></span><span></span><span></span></summary
        ><nav aria-label="Navegación móvil">
          <a href="#servicios">Servicios</a><a href="#como-funciona"
            >Cómo funciona</a
          ><a href="#para-quien">Para quién</a><a href="#preguntas"
            >Preguntas frecuentes</a
          ><a href="#contacto">Contacto</a>
        </nav>
      </details>
    </header>

    <main id="contenido">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="eyebrow-dot"></span> Evaluación profesional de confianza
          </p><h1 id="hero-title">
            Pruebas de polígrafo con evaluación <em>profesional y confidencial.</em>
          </h1><p class="hero-description">
            POLICHECK ofrece servicios de polígrafo y evaluación poligráfica en
            Perú, con un enfoque profesional, estructurado y responsable.
          </p><div class="hero-actions">
            <a
              class="button button-primary"
              href={whatsapp(
                "Hola, quisiera obtener información sobre una evaluación de polígrafo.",
              )}
              target="_blank"
              rel="noreferrer"
              >Solicitar evaluación <span aria-hidden="true">↗</span></a
            ><a class="text-link" href="#como-funciona"
              >Conocer cómo funciona <span aria-hidden="true">↓</span></a>
          </div><p class="trust-note">
            <span class="lock-icon" aria-hidden="true">⌁</span> Información clara,
            tratamiento responsable y consentimiento previo.
          </p>
        </div>
        <div
          class="hero-visual"
          aria-label="Representación ilustrativa de una evaluación poligráfica"
        >
          <div class="visual-glow"></div><div class="evaluation-card">
            <div class="card-topline">
              <span class="live-pill"
                ><span></span> Procedimiento estructurado</span
              ><span>POLICHECK</span>
            </div><div class="card-heading">
              <div class="pulse-icon" aria-hidden="true">⌁</div><div>
                <strong>Evaluación poligráfica</strong><small
                  >Entrevista, registro y análisis</small>
              </div>
            </div><div class="chart" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span
              ></span><span></span><span></span>
            </div><div class="metric-row">
              <div>
                <span>Entrevista previa</span><b>Preguntas revisadas</b>
              </div><div>
                <span>Durante la evaluación</span><b>Registro fisiológico</b>
              </div><div>
                <span>Posteriormente</span><b>Análisis del proceso</b>
              </div>
            </div><div class="card-footer">
              <span>Confidencialidad y consentimiento</span><span
                aria-hidden="true">↗</span>
            </div>
          </div><div class="floating-tag tag-top">
            <span>✓</span> Proceso informado
          </div><div class="floating-tag tag-bottom">
            <span>⌁</span> Atención personalizada
          </div>
        </div>
      </section>

      <div class="trust-strip" aria-label="Principios de POLICHECK">
        <span>Evaluación profesional</span><i></i><span
          >Consentimiento informado</span
        ><i></i><span>Tratamiento responsable</span><i></i><span
          >Comunicación clara</span>
      </div>

      <section class="education-section" aria-labelledby="que-es">
        <div class="section-kicker">01 / Comprender el proceso</div><div
          class="education-grid"
        >
          <div>
            <h2 id="que-es">¿Qué es una prueba de <em>polígrafo?</em></h2><p>
              Es una herramienta de evaluación que integra una entrevista y el
              registro de determinadas respuestas fisiológicas ante preguntas
              previamente revisadas.
            </p>
          </div><div class="education-detail">
            <p>
              Una evaluación poligráfica no reemplaza una decisión profesional,
              legal o empresarial. Es un procedimiento estructurado que debe
              explicarse con claridad y realizarse de forma responsable.
            </p><a class="text-link dark-link" href="#contacto"
              >Consultar mi caso <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section
        class="steps-section"
        id="como-funciona"
        aria-labelledby="steps-title"
      >
        <div class="section-heading">
          <div>
            <div class="section-kicker">02 / Cómo funciona</div><h2
              id="steps-title"
            >
              Un proceso explicado <em>paso a paso.</em>
            </h2>
          </div><p>
            El alcance puede variar según el tipo de evaluación y las
            características del caso.
          </p>
        </div><ol class="steps-grid">
          <li class="step-card step-card-dark">
            <span class="step-number">01</span><div
              class="step-icon"
              aria-hidden="true"
            >
              ◌
            </div><h3>Entrevista previa</h3><p>
              Se explica el procedimiento y se revisan los temas que serán
              evaluados.
            </p>
          </li><li class="step-card step-card-yellow">
            <span class="step-number">02</span><div
              class="step-icon"
              aria-hidden="true"
            >
              ✓
            </div><h3>Preparación</h3><p>
              Se verifica que la persona comprenda las preguntas y las
              condiciones del proceso.
            </p>
          </li><li class="step-card step-card-light">
            <span class="step-number">03</span><div
              class="step-icon"
              aria-hidden="true"
            >
              ⌁
            </div><h3>Registro fisiológico</h3><p>
              El equipo registra variables fisiológicas durante la evaluación.
            </p>
          </li><li class="step-card step-card-dark">
            <span class="step-number">04</span><div
              class="step-icon"
              aria-hidden="true"
            >
              ⌁
            </div><h3>Análisis</h3><p>
              Las gráficas y registros se analizan dentro del procedimiento
              correspondiente.
            </p>
          </li><li class="step-card step-card-light">
            <span class="step-number">05</span><div
              class="step-icon"
              aria-hidden="true"
            >
              ↗
            </div><h3>Resultado o informe</h3><p>
              Se comunica según las condiciones del servicio contratado.
            </p>
          </li>
        </ol>
      </section>

      <section
        class="services-section"
        id="servicios"
        aria-labelledby="services-title"
      >
        <div class="section-heading">
          <div>
            <div class="section-kicker">03 / Servicios</div><h2
              id="services-title"
            >
              Orientación para cada <em>necesidad.</em>
            </h2>
          </div><a
            class="button button-primary"
            href={whatsapp(
              "Hola, quisiera recibir información sobre los servicios de POLICHECK",
            )}
            target="_blank"
            rel="noreferrer"
            >Hablar por WhatsApp <span aria-hidden="true">↗</span></a>
        </div><div class="services-grid">
          {
            services.map(([title, description, icon]) => (
              <article class="service-card">
                <>
                  <span class="service-icon" aria-hidden="true">
                    {icon}
                  </span>
                  <h3>{title}</h3>
                  <p>{description}</p>
                  <a
                    href={whatsapp(
                      `Hola, quisiera información sobre el servicio de ${title}.`,
                    )}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Consultar por WhatsApp <span aria-hidden="true">↗</span>
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="audience-section"
        id="para-quien"
        aria-labelledby="audience-title"
      >
        <div class="audience-copy">
          <div class="section-kicker">04 / Según el caso</div><h2
            id="audience-title"
          >
            Evaluaciones para diferentes <em>necesidades.</em>
          </h2><p>
            La conveniencia de una evaluación debe revisarse previamente.
            POLICHECK orienta cada consulta según las características y el
            contexto del caso.
          </p><a
            class="text-link dark-link"
            href={whatsapp(
              "Hola, quisiera orientación sobre una evaluación de polígrafo.",
            )}
            target="_blank"
            rel="noreferrer"
            >Quiero orientación <span aria-hidden="true">↗</span></a>
        </div><div class="audience-list">
          <article>
            <span>01</span><div>
              <h3>Empresas</h3><p>
                Procesos relacionados con selección o evaluación de personal,
                cuando corresponda.
              </p>
            </div>
          </article><article>
            <span>02</span><div>
              <h3>Selección de personal</h3><p>
                Como herramienta complementaria dentro de determinados procesos
                de selección.
              </p>
            </div>
          </article><article>
            <span>03</span><div>
              <h3>Situaciones específicas</h3><p>
                Evaluaciones centradas en hechos o situaciones concretas.
              </p>
            </div>
          </article><article>
            <span>04</span><div>
              <h3>Evaluaciones internas</h3><p>
                Para situaciones que una organización necesite analizar.
              </p>
            </div>
          </article><article>
            <span>05</span><div>
              <h3>Personas particulares</h3><p>
                Personas que buscan orientación sobre una situación específica.
              </p>
            </div>
          </article>
        </div>
      </section>

      <section class="standards-section" aria-labelledby="standards-title">
        <div class="section-kicker">05 / Una expectativa razonable</div><h2
          id="standards-title"
        >
          ¿Qué deberías esperar de un servicio <em>profesional?</em>
        </h2><div class="standards-grid">
          <article>
            <span aria-hidden="true">01</span><h3>
              Información y consentimiento
            </h3><p>
              La persona debe conocer previamente el procedimiento y sus
              condiciones antes de decidir participar.
            </p>
          </article><article>
            <span aria-hidden="true">02</span><h3>Proceso estructurado</h3><p>
              La entrevista, el registro de respuestas fisiológicas y el
              análisis posterior forman parte de una evaluación responsable.
            </p>
          </article><article>
            <span aria-hidden="true">03</span><h3>Privacidad y reserva</h3><p>
              La información del caso debe tratarse con responsabilidad, respeto
              y condiciones claras para el cliente.
            </p>
          </article><article>
            <span aria-hidden="true">04</span><h3>Revisión profesional</h3><p>
              Los resultados deben analizarse dentro del procedimiento que
              corresponda, sin promesas de certeza absoluta.
            </p>
          </article>
        </div>
      </section>

      <section class="principles-section">
        <article>
          <span class="principle-icon" aria-hidden="true">⌁</span><h2>
            Tu información merece <em>privacidad.</em>
          </h2><p>
            La información proporcionada durante el proceso debe ser tratada de
            manera responsable y reservada, de acuerdo con las condiciones
            informadas al cliente.
          </p>
        </article><article>
          <span class="principle-icon" aria-hidden="true">✓</span><h2>
            Una evaluación responsable comienza con el <em>consentimiento.</em>
          </h2><p>
            La persona debe conocer el procedimiento y sus condiciones antes de
            decidir si participa. Resolver dudas antes de empezar es parte de
            una atención clara.
          </p>
        </article>
      </section>

      <section class="company-section" aria-labelledby="company-title">
        <div>
          <div class="section-kicker">06 / Para organizaciones</div><h2
            id="company-title"
          >
            Cuando una empresa necesita <em>orientación.</em>
          </h2><p>
            Conversemos sobre evaluaciones de polígrafo como herramienta
            complementaria para determinados procesos de selección, confianza o
            situaciones internas. La viabilidad debe analizarse según el caso.
          </p><a
            class="button button-dark"
            href={whatsapp(
              "Hola, represento a una empresa y quisiera consultar sobre evaluaciones de polígrafo.",
            )}
            target="_blank"
            rel="noreferrer"
            >Consulta para empresas <span aria-hidden="true">↗</span></a>
        </div><div class="company-visual" aria-hidden="true">
          <div></div><span>Consulta<br />personalizada</span><i>01</i>
        </div>
      </section>

      <section class="cta-section">
        <div class="section-kicker">
          El siguiente paso es una conversación
        </div><h2>La claridad empieza <em>aquí.</em></h2><p>
          Cuéntanos qué necesitas y te orientaremos sobre el servicio de
          evaluación adecuado para tu caso.
        </p><a
          class="button button-primary"
          href={whatsapp(
            "Hola, quisiera recibir información sobre los servicios de POLICHECK",
          )}
          target="_blank"
          rel="noreferrer"
          >Hablar por WhatsApp <span aria-hidden="true">↗</span></a>
      </section>

      <section class="faq-section" id="preguntas" aria-labelledby="faq-title">
        <div class="faq-heading">
          <div class="section-kicker">07 / Preguntas frecuentes</div><h2
            id="faq-title"
          >
            Respuestas claras antes de <em>decidir.</em>
          </h2>
        </div><div class="faq-list">
          {
            faq.map(([question, answer], index) => (
              <details open={index === 0}>
                <>
                  <summary>
                    {question}
                    <span aria-hidden="true">+</span>
                  </summary>
                  <p>{answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </section>

      <section
        class="contact-section"
        id="contacto"
        aria-labelledby="contact-title"
      >
        <div class="contact-copy">
          <div class="section-kicker">08 / Contacto</div><h2 id="contact-title">
            Cuéntanos sobre <em>tu caso.</em>
          </h2><p>
            Bríndanos algunos datos y te orientaremos sobre el servicio que
            puede corresponder a tu necesidad.
          </p>
        </div><ContactForm client:load />
      </section>
    </main>
    <footer class="site-footer">
      <div class="footer-column footer-brand-column">
        <a class="brand footer-brand" href="/" aria-label="POLICHECK, inicio"
          ><span class="brand-mark" aria-hidden="true"
            ><span></span><span></span><span></span></span
          ><span>POLICHECK</span></a
        ><p class="footer-tagline">Evaluación profesional de confianza.</p><p class="footer-description">Servicios de evaluación poligráfica orientados a personas y organizaciones que necesitan mayor claridad ante situaciones de confianza.</p>
      </div><nav class="footer-column footer-links" aria-label="Navegación del pie">
        <p class="footer-label">Navegación</p><ul><li><a href="#servicios">Servicios</a></li><li><a href="#como-funciona">Cómo funciona</a></li><li><a href="#para-quien">Para quién</a></li><li><a href="#preguntas">Preguntas frecuentes</a></li><li><a href="#contacto">Contacto</a></li></ul>
      </nav><div class="footer-column footer-contact">
        <p class="footer-label">Contacto</p><strong>+51 966 994 027</strong><a class="footer-whatsapp"
          href={whatsapp(
            "Hola, quisiera recibir información sobre los servicios de POLICHECK",
          )}
          target="_blank"
          rel="noreferrer">Hablar por WhatsApp <span aria-hidden="true">↗</span></a>
      </div><small
        >© 2026 POLICHECK. Todos los derechos reservados.</small>
    </footer>
  </div>
  <a
    class="whatsapp-float"
    href={whatsapp(
      "Hola, quisiera recibir información sobre los servicios de POLICHECK",
    )}
    target="_blank"
    rel="noreferrer"
    aria-label="Contactar a POLICHECK por WhatsApp"
    ><span aria-hidden="true">⌕</span><b>Habla con POLICHECK</b></a
  >
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    background: #f4f1e9;
    color: #172422;
  }
  :global(a) {
    color: inherit;
  }
  :global(button),
  :global(input),
  :global(select),
  :global(textarea) {
    font: inherit;
  }
  :global(a:focus-visible),
  :global(button:focus-visible),
  :global(summary:focus-visible),
  :global(input:focus-visible),
  :global(select:focus-visible),
  :global(textarea:focus-visible) {
    outline: 3px solid #778f0e;
    outline-offset: 4px;
  }
  .page-shell {
    overflow: clip;
  }
  .site-header,
  main,
  .site-footer {
    width: min(1180px, calc(100% - 64px));
    margin: 0 auto;
  }
  .skip-link {
    position: fixed;
    z-index: 20;
    top: -100px;
    left: 20px;
    padding: 13px 18px;
    border-radius: 8px;
    color: #172422;
    background: #d7f35a;
    font-weight: 700;
    text-decoration: none;
  }
  .skip-link:focus {
    top: 16px;
  }
  .site-header {
    position: relative;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(23, 36, 34, 0.18);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font:
      700 20px/1 "DM Sans",
      Arial,
      sans-serif;
    letter-spacing: -0.05em;
    text-decoration: none;
  }
  .brand-mark {
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: end;
    justify-content: center;
    gap: 3px;
    padding: 5px;
    border-radius: 7px;
    background: #d7f35a;
    transform: rotate(-8deg);
  }
  .brand-mark span {
    display: block;
    width: 3px;
    background: #172422;
    border-radius: 3px;
    transform: rotate(8deg);
  }
  .brand-mark span:nth-child(1) {
    height: 7px;
  }
  .brand-mark span:nth-child(2) {
    height: 12px;
  }
  .brand-mark span:nth-child(3) {
    height: 16px;
  }
  .desktop-nav {
    display: flex;
    gap: 27px;
    margin-left: auto;
    margin-right: 34px;
    color: #495650;
    font:
      500 15px/1 "DM Sans",
      Arial,
      sans-serif;
  }
  .desktop-nav a,
  .footer-links a {
    text-decoration: none;
  }
  .desktop-nav a:hover,
  .footer-links a:hover {
    color: #718b0c;
  }
  .header-cta,
  .button {
    display: inline-flex;
